{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anchor",
  "version": "1.0.0",
  "identifier": "com.anchor.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev --host 127.0.0.1",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anchor",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "dragDropEnabled": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https: http:;"
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": false,
    "icon": ["../assets/anchor_logo_64.png"]
  }
}
